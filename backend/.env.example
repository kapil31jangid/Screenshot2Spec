# Google AI Studio API Key (Server-side secret, NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemma 4 Multimodal Model
# Recommended: gemma-4-26b-a4b-it (normalized to models/gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Standalone backend port (default: 3001)
BACKEND_PORT=3001
