{
  "name": "screenshot2spec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run backend:test",
    "test:live": "tsx --test backend/tests/live-integration.test.ts",
    "backend:dev": "tsx watch backend/src/server.ts",
